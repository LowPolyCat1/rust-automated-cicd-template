{
  "id": 16408240,
  "name": "Protect Main/Master/Default",
  "target": "branch",
  "source_type": "Repository",
  "source": "LowPolyCat1/locale-rs",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "exclude": [],
      "include": [
        "~DEFAULT_BRANCH",
        "refs/heads/main",
        "refs/heads/master"
      ]
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": true,
        "required_reviewers": [],
        "require_code_owner_review": true,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true,
        "require_extra_approval_for_unattributed_changes": true,
        "allowed_merge_methods": [
          "merge",
          "squash",
          "rebase"
        ]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "clippy",
            "integration_id": 15368
          },
          {
            "context": "build (macos-latest, stable)",
            "integration_id": 15368
          },
          {
            "context": "build (ubuntu-latest, stable)",
            "integration_id": 15368
          },
          {
            "context": "build (windows-latest, stable)",
            "integration_id": 15368
          },
          {
            "context": "test",
            "integration_id": 15368
          },
          {
            "context": "fmt",
            "integration_id": 15368
          },
          {
            "context": "cargo-deny (advisories)",
            "integration_id": 15368
          },
          {
            "context": "cargo-deny (licenses)",
            "integration_id": 15368
          },
          {
            "context": "semver",
            "integration_id": 15368
          },
          {
            "context": "GitGuardian Security Checks",
            "integration_id": 46505
          }
        ]
      }
    },
    {
      "type": "required_linear_history"
    },
    {
      "type": "code_quality",
      "parameters": {
        "severity": "all"
      }
    }
  ],
  "bypass_actors": []
}